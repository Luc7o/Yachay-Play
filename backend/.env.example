# Copia como ".env" (local) o cárgalo en el panel de tu hosting. NUNCA subas ".env" a GitHub.
# Neon (cadena pooled) o Supabase (Session pooler). No pongas comentarios en la misma línea.
DATABASE_URL=postgresql://USUARIO:PASSWORD@HOST/neondb?sslmode=require
GEMINI_API_KEY=
# Clave larga y aleatoria para firmar sesiones (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET=
NODE_ENV=production
# URL(s) del frontend en Vercel, separadas por coma (sin / final)
CORS_ORIGIN=https://tu-proyecto.vercel.app
SEED_DEMO_USERS=false
