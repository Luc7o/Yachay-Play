# Copia como ".env" (local) o cárgalo en el panel de tu hosting. NUNCA subas ".env" a GitHub.
# Neon (cadena pooled) o Supabase (Session pooler). No pongas comentarios en la misma línea.
DATABASE_URL=postgresql://USUARIO:PASSWORD@HOST/neondb?sslmode=require
GEMINI_API_KEY=
# Clave larga y aleatoria para firmar sesiones (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET=
NODE_ENV=production
# URL(s) del frontend en Vercel, separadas por coma (sin / final)
CORS_ORIGIN=https://tu-proyecto.vercel.app
# Cuentas demo (claves públicas). Solo actívalas en local: SEED_DEMO_USERS=true
SEED_DEMO_USERS=false
# Proxies delante del servidor (Render/Railway/Fly: 1; Cloudflare + Render: 2; ninguno: 0)
TRUST_PROXY=1
# TLS de la base de datos: se verifica el certificado. Para Supabase pega su certificado raíz
# (PEM, con \n en lugar de saltos de línea) en DB_SSL_CA. DB_SSL_INSECURE=true lo desactiva (no recomendado).
DB_SSL_CA=
DB_SSL_INSECURE=false
# ID de cliente OAuth de Google (Google Auth Platform > Clientes). Termina en .apps.googleusercontent.com
GOOGLE_CLIENT_ID=

# --- Correos (recuperar contraseña y verificar correo) con Resend: https://resend.com ---
# Sin RESEND_API_KEY en producción NO se envía ningún correo (en desarrollo el enlace sale en la consola).
RESEND_API_KEY=
# El dominio del remitente debe estar verificado en Resend
MAIL_FROM=YachayPlay <no-responder@tudominio.com>
# URL pública del frontend, para armar los enlaces de los correos (sin / final)
FRONTEND_URL=https://tu-proyecto.vercel.app
