{
  "name": "yachayplay-backend",
  "version": "0.1.0",
  "type": "module",
  "description": "Backend con Express + Socket.IO + PostgreSQL (Neon) de YachayPlay",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "migrate": "node migrate.js up",
    "migrate:status": "node migrate.js status",
    "migrate:new": "node migrate.js new",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "dev:db": "node scripts/dev-db.js",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "nanoid": "^5.0.7",
    "pg": "^8.13.0",
    "qrcode": "^1.5.4",
    "rollbar": "^4.2.1",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@electric-sql/pglite-socket": "^0.3.0",
    "@eslint/js": "^9.39.5",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
