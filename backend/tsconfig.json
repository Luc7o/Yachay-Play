{
  // El backend sigue en JavaScript, pero tsc revisa TODOS los archivos (checkJs)
  // con los tipos de tipos.d.ts y de ../shared/types (vía JSDoc donde hace falta).
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["**/*.js", "tipos.d.ts", "../shared/types"],
  "exclude": ["node_modules", "**/*.test.js"]
}
