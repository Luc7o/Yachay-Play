{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["vite/client"]
  },
  "include": ["src", "../shared/types"],
  // Pantallas en migración (ver tsconfig.pantallas.json): se revisan aparte.
  "exclude": [
    "src/**/*.test.jsx",
    "src/App.tsx",
    "src/AssistantFab.tsx",
    "src/AuthExtras.tsx",
    "src/AuthScreen.tsx",
    "src/Cronometro.tsx",
    "src/ErrorBoundary.tsx",
    "src/GameCatalog.tsx",
    "src/GameGate.tsx",
    "src/GoogleButton.tsx",
    "src/PalabraRelampago.tsx",
    "src/Profile.tsx",
    "src/QuestionBank.tsx",
    "src/Stats.tsx",
    "src/TwoFactorSettings.tsx",
    "src/clases/Clases.tsx",
    "src/cw/CrosswordGame.tsx",
    "src/cw/CwBoardPlay.tsx",
    "src/cw/CwGate.tsx",
    "src/cw/CwStudentRoom.tsx",
    "src/cw/CwTeacherLive.tsx",
    "src/cw/CwTeacherRoom.tsx",
    "src/estudio/Editor.tsx",
    "src/estudio/Estudio.tsx",
    "src/estudio/SlideView.tsx",
    "src/estudio/TeacherRoom.tsx",
    "src/ludo/Dice.tsx",
    "src/ludo/EngineerGame.tsx",
    "src/ludo/GameTab.tsx",
    "src/ludo/InfoTabs.tsx",
    "src/ludo/LobbyScreen.tsx",
    "src/ludo/LudoBoard.tsx",
    "src/ludo/LudoPantallas.tsx",
    "src/ludo/SetupScreen.tsx",
    "src/ludo/Student.tsx",
    "src/main.tsx",
    "src/palabra/PalabraOnline.tsx",
    "src/palabra/PalabraSolo.tsx",
    "src/pantallas.tsx",
    "src/sesion/PantallaCuenta.tsx"
  ]
}
